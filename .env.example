# Local server
PORT=3000
NODE_ENV=development

# Supabase (recommended for permanent inquiry storage)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Resend (recommended for instant email notifications)
RESEND_API_KEY=re_YOUR_API_KEY
CONTACT_TO_EMAIL=your-email@example.com
CONTACT_FROM_EMAIL=Portfolio <contact@your-verified-domain.com>

# Lets local development save to data/inquiries.json when integrations are not configured.
# Keep false/omit in production.
LOCAL_INQUIRY_FALLBACK=true
